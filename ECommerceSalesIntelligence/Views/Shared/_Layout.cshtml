<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;display=swap" rel="stylesheet" />
    <style>
        @@layer base {
            html, body {
                margin: 0;
                padding: 0;
            }

            body {
                overscroll-behavior: none;
            }

            main > :first-child {
                margin-top: 0 !important;
            }

            main > :last-child {
                margin-bottom: 0 !important;
            }
        }

        ::-webkit-scrollbar {
            display: none;
        }</style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
          tailwind.config = {
            darkMode: "class",
            theme: {
              extend: {
                "colors": {
                        "inverse-on-surface": "#eaf1ff",
                        "on-tertiary-container": "#0c9488",
                        "surface-variant": "#d3e4fe",
                        "surface-container-high": "#dce9ff",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#005049",
                        "on-error-container": "#93000a",
                        "primary-fixed": "#dae2fd",
                        "surface-dim": "#cbdbf5",
                        "background": "#f8f9ff",
                        "outline-variant": "#c6c6cd",
                        "error": "#ba1a1a",
                        "surface-container-highest": "#d3e4fe",
                        "tertiary": "#000000",
                        "on-error": "#ffffff",
                        "surface": "#f8f9ff",
                        "on-primary-fixed-variant": "#3f465c",
                        "on-surface-variant": "#45464d",
                        "secondary-fixed-dim": "#b4c5ff",
                        "surface-container": "#e5eeff",
                        "on-tertiary": "#ffffff",
                        "surface-bright": "#f8f9ff",
                        "primary": "#000000",
                        "primary-container": "#131b2e",
                        "tertiary-fixed-dim": "#6bd8cb",
                        "surface-tint": "#565e74",
                        "on-secondary-fixed": "#00174b",
                        "inverse-primary": "#bec6e0",
                        "secondary": "#0051d5",
                        "on-secondary-container": "#fefcff",
                        "on-surface": "#0b1c30",
                        "on-tertiary-fixed": "#00201d",
                        "on-primary-container": "#7c839b",
                        "secondary-container": "#316bf3",
                        "on-secondary": "#ffffff",
                        "on-secondary-fixed-variant": "#003ea8",
                        "primary-fixed-dim": "#bec6e0",
                        "secondary-fixed": "#dbe1ff",
                        "outline": "#76777d",
                        "on-primary-fixed": "#131b2e",
                        "surface-container-low": "#eff4ff",
                        "tertiary-container": "#00201d",
                        "tertiary-fixed": "#89f5e7",
                        "inverse-surface": "#213145",
                        "surface-container-lowest": "#ffffff",
                        "on-background": "#0b1c30",
                        "on-primary": "#ffffff"
                },
                "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                },
                "spacing": {
                        "stack-md": "16px",
                        "stack-sm": "8px",
                        "stack-lg": "32px",
                        "gutter": "16px",
                        "base": "4px",
                        "container-margin": "24px"
                },
                "fontFamily": {
                        "body-md": [
                                "Inter"
                        ],
                        "data-mono": [
                                "Inter"
                        ],
                        "headline-sm": [
                                "Inter"
                        ],
                        "headline-md": [
                                "Inter"
                        ],
                        "body-lg": [
                                "Inter"
                        ],
                        "display-lg": [
                                "Inter"
                        ],
                        "body-sm": [
                                "Inter"
                        ],
                        "label-md": [
                                "Inter"
                        ]
                },
                "fontSize": {
                        "body-md": [
                                "14px",
                                {
                                        "lineHeight": "20px",
                                        "fontWeight": "400"
                                }
                        ],
                        "data-mono": [
                                "14px",
                                {
                                        "lineHeight": "20px",
                                        "fontWeight": "500"
                                }
                        ],
                        "headline-sm": [
                                "20px",
                                {
                                        "lineHeight": "28px",
                                        "fontWeight": "600"
                                }
                        ],
                        "headline-md": [
                                "24px",
                                {
                                        "lineHeight": "32px",
                                        "letterSpacing": "-0.01em",
                                        "fontWeight": "600"
                                }
                        ],
                        "body-lg": [
                                "16px",
                                {
                                        "lineHeight": "24px",
                                        "fontWeight": "400"
                                }
                        ],
                        "display-lg": [
                                "36px",
                                {
                                        "lineHeight": "44px",
                                        "letterSpacing": "-0.02em",
                                        "fontWeight": "700"
                                }
                        ],
                        "body-sm": [
                                "13px",
                                {
                                        "lineHeight": "18px",
                                        "fontWeight": "400"
                                }
                        ],
                        "label-md": [
                                "12px",
                                {
                                        "lineHeight": "16px",
                                        "letterSpacing": "0.05em",
                                        "fontWeight": "600"
                                }
                        ]
                }
        },
            },
          }
    </script>
</head>
<body class="bg-surface-container-low font-body-md text-on-surface">
    <aside class="fixed left-0 top-0 h-full w-64 bg-surface-container-lowest z-50 flex flex-col shadow-[1px_0_0_rgba(0,0,0,0.05)]">
        <div class="h-16 flex items-center px-6 gap-3 mb-6">
            <span class="material-symbols-outlined text-secondary text-[28px]">insights</span>
            <span class="font-headline-sm text-headline-sm tracking-tight text-on-surface">Precision</span>
        </div>
        <nav class="flex-1 px-3 space-y-1" data-active-classes="bg-secondary-container text-on-secondary-container">
            <a aria-current="page" class="flex items-center px-4 py-2.5 rounded-lg transition-all group bg-secondary-container text-on-secondary-container" data-path="dashboard" href="#">
                <span class="material-symbols-outlined mr-3 text-[20px]">grid_view</span>
                <span class="font-label-md text-label-md">Gösterge Paneli</span>
            </a>
            <a class="flex items-center px-4 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all group" data-path="forecasting" href="#">
                <span class="material-symbols-outlined mr-3 text-[20px]">timeline</span>
                <span class="font-label-md text-label-md">Öngörü</span>
            </a>
            <a class="flex items-center px-4 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all group" data-path="performance-prediction" href="#">
                <span class="material-symbols-outlined mr-3 text-[20px]">query_stats</span>
                <span class="font-label-md text-label-md">Performans</span>
            </a>
            <a class="flex items-center px-4 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all group" data-path="anomaly-detection" href="#">
                <span class="material-symbols-outlined mr-3 text-[20px]">warning</span>
                <span class="font-label-md text-label-md">Anomaliler</span>
            </a>
            <a class="flex items-center px-4 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all group" data-path="city-clustering" href="#">
                <span class="material-symbols-outlined mr-3 text-[20px]">hub</span>
                <span class="font-label-md text-label-md">Şehir Kümeleri</span>
            </a>
            <a class="flex items-center px-4 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all group" data-path="model-reports" href="#">
                <span class="material-symbols-outlined mr-3 text-[20px]">assignment</span>
                <span class="font-label-md text-label-md">Model Raporları</span>
            </a>
        </nav>
        <footer class="p-4 border-t border-outline-variant/30 mt-auto">
            <div class="flex items-center justify-between px-2">
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-on-tertiary-container"></div>
                    <span class="text-[10px] font-label-md text-on-surface-variant uppercase tracking-widest">Sistem Aktif</span>
                </div>
                <span class="text-[10px] font-data-mono text-outline">v2.4.1-STABLE</span>
            </div>
        </footer>
    </aside>

    <div class="pl-64 flex flex-col min-h-screen">
        <header class="fixed top-0 left-64 right-0 h-16 bg-surface/80 backdrop-blur-xl z-40 flex items-center justify-between px-8 shadow-[0_1px_8px_rgba(0,0,0,0.02)]">
            <div class="flex items-center gap-4 text-outline">
                <span class="material-symbols-outlined cursor-pointer">search</span>
                <span class="font-body-sm text-body-sm">/ tuşuna basarak ML içgörülerini arayın...</span>
            </div><div class="flex items-center gap-6">
                <div class="flex items-center gap-2 px-3 py-1.5 bg-surface-container rounded-full">
                    <span class="material-symbols-outlined text-[16px] text-on-tertiary-container">memory</span>
                    <span class="text-[11px] font-label-md text-on-surface uppercase">ML.NET Aktif</span>
                </div>
                <div class="flex items-center gap-4">
                    <span class="material-symbols-outlined text-on-surface-variant cursor-pointer">notifications</span>
                    <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center cursor-pointer">
                        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                    </div>
                </div>
            </div>
        </header>
       
        <main class="flex-1 pt-16 bg-surface-container-low min-h-[calc(100vh-64px)]">
            @RenderBody()
        </main>

    </div>
</body>
</html>

@await RenderSectionAsync("Scripts", required: false)
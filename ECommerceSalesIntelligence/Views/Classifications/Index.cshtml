@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex flex-col w-full font-body-md text-on-surface p-8 gap-stack-lg">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-stack-md w-full max-w-[1400px] mx-auto">
        <div class="flex flex-col gap-stack-sm">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary">analytics</span>
                <span class="font-label-md text-label-md uppercase tracking-widest text-on-surface-variant">Performans Tahmini</span>
            </div>
            <h1 class="font-display-lg text-display-lg text-on-surface m-0 p-0">Sınıflandırma Modelleri</h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl m-0">
                Ürün yaşam döngüleri boyunca tahmine dayalı doğruluğun şununla değerlendirilmesi: <code class="font-data-mono text-data-mono bg-surface-container px-2 py-1 rounded-md text-secondary">SdcaLogisticRegression</code>.
            </p>
        </div>
        <div class="flex items-center gap-4 bg-surface p-4 rounded-xl shadow-sm border border-outline-variant/30">
            <div class="flex flex-col gap-1">
                <span class="font-label-md text-label-md text-on-surface-variant">Mevcut Eşik</span>
                <span class="font-headline-sm text-headline-sm text-on-surface">7.000 Birim</span>
            </div>
            <div class="w-px h-10 bg-outline-variant/50"></div>
            <button class="bg-primary text-on-primary font-label-md text-label-md px-4 py-2 rounded-lg hover:bg-primary/90 transition-colors shadow-md">
                Parametreleri Ayarla
            </button>
        </div>
    </div>
    <div class="flex flex-col xl:flex-row gap-stack-lg w-full max-w-[1400px] mx-auto">
        <!-- Left Column: Binary & Multiclass -->
        <div class="flex-1 flex flex-col gap-stack-lg">
            <!-- Binary Classification Section -->
            <section class="bg-surface-container-lowest rounded-2xl shadow-sm p-6 relative overflow-hidden">
                <div class="absolute top-0 left-0 w-1 h-full bg-secondary"></div>
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container">
                            <span class="material-symbols-outlined">call_split</span>
                        </div>
                        <div>
                            <h2 class="font-headline-md text-headline-md text-on-surface m-0">İkili Çıkarım</h2>
                            <span class="font-body-sm text-body-sm text-on-surface-variant">Hedef Gerçekleşmesini Tahmin Etme (E/H)</span>
                        </div>
                    </div>
                    <span class="bg-inverse-surface text-inverse-on-surface font-label-md text-label-md px-3 py-1 rounded-full shadow-md">Gerçek Zamanlı</span>
                </div>
                <div class="bg-surface-container-low rounded-xl p-4 flex flex-col gap-4">
                    <div class="grid grid-cols-3 gap-4 border-b border-outline-variant/20 pb-4">
                        <div class="flex flex-col">
                            <span class="font-label-md text-label-md text-on-surface-variant mb-1">Ürün Kimliği</span>
                            <span class="font-data-mono text-data-mono text-on-surface">PRD-X789-2A</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-label-md text-label-md text-on-surface-variant mb-1">Son 3A Ort</span>
                            <span class="font-data-mono text-data-mono text-on-surface">6,842 birim</span>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-label-md text-label-md text-on-surface-variant mb-1">YB İvme</span>
                            <span class="font-data-mono text-data-mono text-on-surface">+12.4%</span>
                        </div>
                    </div>
                    <div class="flex flex-col md:flex-row items-center gap-6 pt-2">
                        <div class="flex-1 w-full">
                            <div class="flex justify-between mb-2">
                                <span class="font-label-md text-label-md text-on-surface">Eşiği Aşma Olasılığı</span>
                                <span class="font-data-mono text-data-mono text-secondary">87.3%</span>
                            </div>
                            <div class="w-full h-3 bg-surface-container-highest rounded-full overflow-hidden">
                                <div class="h-full bg-secondary rounded-full" style="width: 87.3%"></div>
                            </div>
                        </div>
                        <div class="shrink-0 flex items-center justify-center bg-tertiary-container text-on-tertiary-container font-headline-md text-headline-md w-24 h-24 rounded-2xl shadow-md border border-tertiary-container/20">
                            EVET
                        </div>
                    </div>
                </div>
            </section>
            <!-- Multiclass Classification Section -->
            <section class="bg-surface-container-lowest rounded-2xl shadow-sm p-6 relative">
                <div class="absolute top-0 left-0 w-1 h-full bg-tertiary-container"></div>
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 rounded-full bg-tertiary-container flex items-center justify-center text-on-tertiary-container">
                        <span class="material-symbols-outlined">category</span>
                    </div>
                    <div>
                        <h2 class="font-headline-md text-headline-md text-on-surface m-0">Çok Sınıflı Kategorizasyon</h2>
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Talep Bantlama ve Sınıf Sınırları</span>
                    </div>
                </div>
                <div class="flex gap-4 mb-6">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-error"></div>
                        <span class="font-label-md text-label-md text-on-surface-variant">&lt; 3k (Düşük)</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-secondary"></div>
                        <span class="font-label-md text-label-md text-on-surface-variant">3k - 7k (Orta)</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-on-tertiary-container"></div>
                        <span class="font-label-md text-label-md text-on-surface-variant">&gt; 7k (Yüksek)</span>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-surface-container-low">
                                <th class="p-3 font-label-md text-label-md text-on-surface-variant rounded-tl-lg">SKU</th>
                                <th class="p-3 font-label-md text-label-md text-on-surface-variant">Öngörülen Hacim</th>
                                <th class="p-3 font-label-md text-label-md text-on-surface-variant">Güven</th>
                                <th class="p-3 font-label-md text-label-md text-on-surface-variant rounded-tr-lg">Sınıflandırma</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b border-outline-variant/20 hover:bg-surface-container-lowest transition-colors">
                                <td class="p-3 font-data-mono text-data-mono text-on-surface">PRD-ALPHA-01</td>
                                <td class="p-3 font-data-mono text-data-mono text-on-surface">8,450</td>
                                <td class="p-3">
                                    <div class="w-full h-1.5 bg-surface-container-highest rounded-full max-w-[100px]"><div class="h-full bg-on-tertiary-container rounded-full" style="width: 92%"></div></div>
                                </td>
                                <td class="p-3">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-on-tertiary-container/10 text-on-tertiary-container font-label-md text-label-md shadow-sm border border-on-tertiary-container/20">YÜKSEK TALEP</span>
                                </td>
                            </tr>
                            <tr class="border-b border-outline-variant/20 hover:bg-surface-container-lowest transition-colors">
                                <td class="p-3 font-data-mono text-data-mono text-on-surface">PRD-BETA-02</td>
                                <td class="p-3 font-data-mono text-data-mono text-on-surface">4,120</td>
                                <td class="p-3">
                                    <div class="w-full h-1.5 bg-surface-container-highest rounded-full max-w-[100px]"><div class="h-full bg-secondary rounded-full" style="width: 76%"></div></div>
                                </td>
                                <td class="p-3">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-secondary/10 text-secondary font-label-md text-label-md shadow-sm border border-secondary/20">ORTA TALEP</span>
                                </td>
                            </tr>
                            <tr class="hover:bg-surface-container-lowest transition-colors">
                                <td class="p-3 font-data-mono text-data-mono text-on-surface">PRD-GAMMA-03</td>
                                <td class="p-3 font-data-mono text-data-mono text-on-surface">1,890</td>
                                <td class="p-3">
                                    <div class="w-full h-1.5 bg-surface-container-highest rounded-full max-w-[100px]"><div class="h-full bg-error rounded-full" style="width: 84%"></div></div>
                                </td>
                                <td class="p-3">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-error/10 text-error font-label-md text-label-md shadow-sm border border-error/20">DÜŞÜK TALEP</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
        <!-- Right Column: Evaluation Metrics -->
        <div class="w-full xl:w-96 flex flex-col gap-stack-lg">
            <section class="bg-primary-container text-on-primary-container rounded-2xl shadow-md p-6 relative overflow-hidden">
                <div class="absolute -top-24 -right-24 w-48 h-48 bg-secondary opacity-20 rounded-full blur-2xl"></div>
                <div class="flex items-center gap-2 mb-6">
                    <span class="material-symbols-outlined text-secondary">troubleshoot</span>
                    <h2 class="font-headline-sm text-headline-sm m-0">Değerlendirme Metrikleri</h2>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-surface-container-lowest/10 backdrop-blur-md rounded-xl p-4 border border-outline-variant/10 shadow-sm flex flex-col">
                        <span class="font-label-md text-label-md text-on-surface-variant mb-1">Doğruluk</span>
                        <span class="font-headline-md text-headline-md text-on-surface">94.2%</span>
                        <div class="mt-2 flex items-center text-[10px] font-label-md text-on-tertiary-container bg-on-tertiary-container/10 px-1.5 py-0.5 rounded w-fit">
                            <span class="material-symbols-outlined text-[12px] mr-1">arrow_upward</span> +1.2%
                        </div>
                    </div>
                    <div class="bg-surface-container-lowest/10 backdrop-blur-md rounded-xl p-4 border border-outline-variant/10 shadow-sm flex flex-col">
                        <span class="font-label-md text-label-md text-on-surface-variant mb-1">Kesinlik</span>
                        <span class="font-headline-md text-headline-md text-on-surface">92.8%</span>
                        <div class="mt-2 flex items-center text-[10px] font-label-md text-on-tertiary-container bg-on-tertiary-container/10 px-1.5 py-0.5 rounded w-fit">
                            <span class="material-symbols-outlined text-[12px] mr-1">arrow_upward</span> +0.8%
                        </div>
                    </div>
                    <div class="bg-surface-container-lowest/10 backdrop-blur-md rounded-xl p-4 border border-outline-variant/10 shadow-sm flex flex-col">
                        <span class="font-label-md text-label-md text-on-surface-variant mb-1">Duyarlılık</span>
                        <span class="font-headline-md text-headline-md text-on-surface">95.1%</span>
                        <div class="mt-2 flex items-center text-[10px] font-label-md text-on-tertiary-container bg-on-tertiary-container/10 px-1.5 py-0.5 rounded w-fit">
                            <span class="material-symbols-outlined text-[12px] mr-1">arrow_upward</span> +2.1%
                        </div>
                    </div>
                    <div class="bg-surface-container-lowest/10 backdrop-blur-md rounded-xl p-4 border border-outline-variant/10 shadow-sm flex flex-col">
                        <span class="font-label-md text-label-md text-on-surface-variant mb-1">F1 Puanı</span>
                        <span class="font-headline-md text-headline-md text-on-surface">0.939</span>
                        <div class="mt-2 flex items-center text-[10px] font-label-md text-on-surface-variant bg-surface-variant px-1.5 py-0.5 rounded w-fit">
                            <span class="material-symbols-outlined text-[12px] mr-1">horizontal_rule</span> 0.00
                        </div>
                    </div>
                </div>
            </section>
            <section class="bg-surface-container-lowest rounded-2xl shadow-sm p-6 flex flex-col flex-1">
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-4 m-0">Hata Matrisi</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant mb-6">Birincil sınıflar genelinde normalleştirilmiş doğrulama seti performansı.</p>
                <div class="flex-1 bg-surface-container-low rounded-xl flex items-center justify-center p-4 border border-outline-variant/30 min-h-[200px]">
                    <!-- Placeholder for actual matrix visualization -->
                    <div class="text-center flex flex-col items-center">
                        <span class="material-symbols-outlined text-outline text-[48px] mb-2 opacity-50">grid_on</span>
                        <span class="font-label-md text-label-md text-outline">WebGL Matris Görselleştirme Oluşturma</span>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@model ECommerceSalesIntelligence.Models.ClassificationDashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    string Pct(double value) => (value * 100).ToString("N1") + "%";

    var threshold = Model?.Threshold ?? 650;

    var predictions = Model?.Predictions
        ?? new List<ECommerceSalesIntelligence.Models.Classification.SalesClassificationPrediction>();

    var totalCities = predictions
        .Select(x => x.City)
        .Distinct()
        .Count();

    var predictedAbove = predictions.Count(x => x.PredictedLabel);
    var predictedBelow = predictions.Count(x => !x.PredictedLabel);

    var bestPrediction = predictions
        .OrderByDescending(x => x.Probability)
        .FirstOrDefault();

    // ============================================================
    // SAYFALAMA
    // ============================================================

    const int pageSize = 20;

    int currentPage = 1;

    if (Context.Request.Query["page"].Count > 0)
    {
        int.TryParse(
            Context.Request.Query["page"].ToString(),
            out currentPage);
    }

    if (currentPage < 1)
        currentPage = 1;

    int totalRecords = predictions.Count;

    int totalPages = (int)Math.Ceiling(
        totalRecords / (double)pageSize);

    if (totalPages > 0 && currentPage > totalPages)
        currentPage = totalPages;

    var pagedPredictions = predictions
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
}

<div class="p-6 bg-surface-container-low min-h-screen">

    <!-- BAŞLIK -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">

        <div>
            <h1 class="text-3xl font-bold text-on-surface">
                Binary Satış Analizi
            </h1>

            <p class="text-on-surface-variant mt-1 text-sm">

                <span class="font-mono bg-surface-container px-2.5 py-1 rounded-lg text-secondary text-xs font-semibold">
                    SdcaLogisticRegression
                </span>

                modeli ile gelecek ay satış eşiğinin aşılıp aşılmayacağı tahmin edilmektedir.

            </p>
        </div>

        <!-- METODOLOJİ -->
        <div class="bg-surface px-4 py-3.5 rounded-2xl border border-outline-variant/30 flex items-start gap-3.5 text-xs text-on-surface-variant shadow-sm max-w-xl">

            <span class="material-symbols-outlined text-secondary text-2xl">
                auto_graph
            </span>

            <div>

                <strong class="text-on-surface block mb-1">
                    Tahmin Metodolojisi
                </strong>

                Model;

                <span class="font-semibold text-on-surface">
                    ürün
                </span>,

                <span class="font-semibold text-on-surface">
                    son 3 aylık satış performansı
                </span>,

                <span class="font-semibold text-on-surface">
                    geçen ay satış
                </span>

                ve

                <span class="font-semibold text-on-surface">
                    3 aylık ortalama
                </span>

                bilgilerini kullanır.

                <span class="block mt-1">

                    Gelecek ay satışlarının

                    <strong class="text-secondary">
                        @threshold.ToString("N0") adet ve üzeri
                    </strong>

                    olması

                    <strong class="text-secondary">
                        AŞTI
                    </strong>,

                    altında olması ise

                    <strong class="text-rose-600">
                        ALTINDA
                    </strong>

                    olarak değerlendirilir.

                </span>

            </div>

        </div>

    </div>


    <!-- MODEL METRİKLERİ -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

        <!-- ACCURACY -->
        <div class="bg-surface p-5 rounded-3xl border border-outline-variant/30 shadow-sm flex items-center gap-4">

            <div class="bg-secondary-container p-3.5 rounded-2xl text-on-secondary-container shrink-0">

                <span class="material-symbols-outlined text-3xl">
                    speed
                </span>

            </div>

            <div>

                <p class="text-xs text-on-surface-variant font-semibold tracking-wide uppercase">
                    Doğruluk
                </p>

                <p class="text-2xl font-extrabold text-on-surface mt-0.5">
                    @Pct(Model?.Metrics?.Accuracy ?? 0)
                </p>

                <p class="text-[11px] text-on-surface-variant/80 mt-0.5">
                    Test verisindeki doğru tahmin oranı
                </p>

            </div>

        </div>


        <!-- AUC -->
        <div class="bg-surface p-5 rounded-3xl border border-outline-variant/30 shadow-sm flex items-center gap-4">

            <div class="bg-secondary-container p-3.5 rounded-2xl text-on-secondary-container shrink-0">

                <span class="material-symbols-outlined text-3xl">
                    query_stats
                </span>

            </div>

            <div>

                <p class="text-xs text-on-surface-variant font-semibold tracking-wide uppercase">
                    AUC Skoru
                </p>

                <p class="text-2xl font-extrabold text-on-surface mt-0.5">
                    @((Model?.Metrics?.AreaUnderRocCurve ?? 0).ToString("F3"))
                </p>

                <p class="text-[11px] text-on-surface-variant/80 mt-0.5">
                    Sınıfları ayırt etme başarısı
                </p>

            </div>

        </div>


        <!-- F1 -->
        <div class="bg-surface p-5 rounded-3xl border border-outline-variant/30 shadow-sm flex items-center gap-4">

            <div class="bg-secondary-container p-3.5 rounded-2xl text-on-secondary-container shrink-0">

                <span class="material-symbols-outlined text-3xl">
                    tune
                </span>

            </div>

            <div>

                <p class="text-xs text-on-surface-variant font-semibold tracking-wide uppercase">
                    F1 Puanı
                </p>

                <p class="text-2xl font-extrabold text-on-surface mt-0.5">
                    @Pct(Model?.Metrics?.F1Score ?? 0)
                </p>

                <p class="text-[11px] text-on-surface-variant/80 mt-0.5">
                    Precision ve Recall dengesi
                </p>

            </div>

        </div>


        <!-- PRECISION -->
        <div class="bg-surface p-5 rounded-3xl border border-outline-variant/30 shadow-sm flex items-center gap-4">

            <div class="bg-secondary-container p-3.5 rounded-2xl text-on-secondary-container shrink-0">

                <span class="material-symbols-outlined text-3xl">
                    gps_fixed
                </span>

            </div>

            <div>

                <p class="text-xs text-on-surface-variant font-semibold tracking-wide uppercase">
                    Precision
                </p>

                <p class="text-2xl font-extrabold text-on-surface mt-0.5">
                    @Pct(Model?.Metrics?.PositivePrecision ?? 0)
                </p>

                <p class="text-[11px] text-on-surface-variant/80 mt-0.5">
                    AŞTI tahminlerinin isabet oranı
                </p>

            </div>

        </div>

    </div>


    <!-- ÖZET -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

        <!-- ŞEHİR -->
        <div class="bg-surface p-5 rounded-3xl border border-outline-variant/30 shadow-sm">

            <div class="flex items-center justify-between">

                <div>

                    <p class="text-xs font-semibold uppercase tracking-wide text-on-surface-variant">
                        Analiz Edilen Şehir
                    </p>

                    <p class="text-3xl font-extrabold text-on-surface mt-1">
                        @totalCities
                    </p>

                    <p class="text-xs text-on-surface-variant mt-1">
                        Toplam şehir sayısı
                    </p>

                </div>

                <div class="bg-primary-container p-3 rounded-2xl text-on-primary-container">

                    <span class="material-symbols-outlined text-2xl">
                        location_city
                    </span>

                </div>

            </div>

        </div>


        <!-- AŞTI -->
        <div class="bg-surface p-5 rounded-3xl border border-outline-variant/30 shadow-sm">

            <div class="flex items-center justify-between">

                <div>

                    <p class="text-xs font-semibold uppercase tracking-wide text-on-surface-variant">
                        Gelecek Ay AŞTI
                    </p>

                    <p class="text-3xl font-extrabold text-emerald-600 mt-1">
                        @predictedAbove
                    </p>

                    <p class="text-xs text-on-surface-variant mt-1">
                        @threshold.ToString("N0")+ satış tahmini
                    </p>

                </div>

                <div class="bg-emerald-500/10 p-3 rounded-2xl text-emerald-600">

                    <span class="material-symbols-outlined text-2xl">
                        trending_up
                    </span>

                </div>

            </div>

        </div>


        <!-- ALTINDA -->
        <div class="bg-surface p-5 rounded-3xl border border-outline-variant/30 shadow-sm">

            <div class="flex items-center justify-between">

                <div>

                    <p class="text-xs font-semibold uppercase tracking-wide text-on-surface-variant">
                        Gelecek Ay ALTINDA
                    </p>

                    <p class="text-3xl font-extrabold text-rose-600 mt-1">
                        @predictedBelow
                    </p>

                    <p class="text-xs text-on-surface-variant mt-1">
                        @threshold.ToString("N0") altı satış tahmini
                    </p>

                </div>

                <div class="bg-rose-500/10 p-3 rounded-2xl text-rose-600">

                    <span class="material-symbols-outlined text-2xl">
                        trending_down
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ANA İÇERİK -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">


        <!-- TABLO -->
        <div class="lg:col-span-2 bg-surface p-6 rounded-3xl border border-outline-variant/30 shadow-sm">

            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">

                <div>

                    <h2 class="text-lg font-semibold text-on-surface">
                        Ürün ve Şehir Bazında Gelecek Ay Tahminleri
                    </h2>

                    <p class="text-xs text-on-surface-variant mt-1">
                        Son 3 aylık satış performansına göre
                        @threshold.ToString("N0") adet satış eşiği
                    </p>

                </div>

                <span class="text-xs font-medium text-on-surface-variant bg-surface-container px-3 py-1.5 rounded-full whitespace-nowrap">
                    @predictions.Count Tahmin
                </span>

            </div>


            @if (!predictions.Any())
            {
                <div class="py-12 text-center">

                    <span class="material-symbols-outlined text-4xl text-on-surface-variant">
                        data_alert
                    </span>

                    <p class="mt-3 font-semibold text-on-surface">
                        Tahmin verisi bulunamadı.
                    </p>

                    <p class="text-sm text-on-surface-variant mt-2 max-w-xl mx-auto">
                        @(Model?.Message ?? "Model tahmin oluşturamadı.")
                    </p>

                </div>
            }
            else
            {

                <div class="overflow-x-auto">

                    <table class="w-full text-left text-sm border-collapse">

                        <thead class="text-on-surface-variant text-xs uppercase tracking-wider border-b border-outline-variant/20">

                            <tr>

                                <th class="pb-3.5 font-semibold">
                                    Şehir
                                </th>

                                <th class="pb-3.5 font-semibold">
                                    Ürün
                                </th>

                                <th class="pb-3.5 text-right font-semibold">
                                    Son 3 Ay Toplam
                                </th>

                                <th class="pb-3.5 text-right font-semibold">
                                    Geçen Ay
                                </th>

                                <th class="pb-3.5 text-right font-semibold">
                                    3 Aylık Ortalama
                                </th>

                                <th class="pb-3.5 text-center font-semibold">
                                    Tahmin
                                </th>

                                <th class="pb-3.5 text-right font-semibold">
                                    Probability
                                </th>

                            </tr>

                        </thead>


                        <tbody class="divide-y divide-outline-variant/10">

                            @foreach (var p in pagedPredictions)
                            {
                                var probability =
                                Math.Clamp(
                                p.Probability,
                                0f,
                                1f);

                                var probPercent =
                                (int)Math.Round(
                                probability * 100);

                                <tr class="hover:bg-surface-container-low/60 transition-colors">

                                    <!-- ŞEHİR -->
                                    <td class="py-3.5 font-semibold text-on-surface whitespace-nowrap">
                                        @p.City
                                    </td>

                                    <!-- ÜRÜN -->
                                    <td class="py-3.5 text-xs text-on-surface-variant whitespace-nowrap">
                                        @p.ProductName
                                    </td>

                                    <!-- SON 3 AY -->
                                    <td class="py-3.5 text-right font-mono text-xs text-on-surface-variant">
                                        @p.LastThreeMonthsSales.ToString("N0")
                                    </td>

                                    <!-- SON AY -->
                                    <td class="py-3.5 text-right font-mono text-xs text-on-surface-variant">
                                        @p.LastMonthSales.ToString("N0")
                                    </td>

                                    <!-- ORTALAMA -->
                                    <td class="py-3.5 text-right font-mono text-xs font-bold text-on-surface">
                                        @p.ThreeMonthAverage.ToString("N0")
                                    </td>

                                    <!-- EVET / HAYIR -->
                                    <td class="py-3.5 text-center">

                                        <span class="px-3 py-1 rounded-full text-xs font-extrabold tracking-wide inline-flex items-center gap-1
                                                    @(p.PredictedLabel
                                                                                              ? "bg-emerald-500/15 text-emerald-600 border border-emerald-500/30"
                                                                                              : "bg-rose-500/15 text-rose-600 border border-rose-500/30")">

                                            <span class="w-1.5 h-1.5 rounded-full
                                                        @(p.PredictedLabel
                                                                                                      ? "bg-emerald-500"
                                                                                                      : "bg-rose-500")">
                                                                                                                </span>

                                            @(p.PredictedLabel
                                                                                ? "EVET"
                                                                                : "HAYIR")

                                </span>

                                    </td>

                                    <!-- PROBABILITY -->
                                    <td class="py-3.5 text-right font-mono">

                                        <div class="flex items-center justify-end gap-2">

                                            <span class="text-xs font-bold text-on-surface">
                                                @probPercent%
                                            </span>

                                            <div class="w-14 bg-surface-container h-1.5 rounded-full overflow-hidden hidden sm:block">

                                                <div class="bg-secondary h-full rounded-full"
                                                     style="width: @probPercent%">
                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                </tr>
                                                }

                        </tbody>

                    </table>
                    @if (totalPages > 1)
                    {
                        <div class="mt-5 pt-4 border-t border-outline-variant/20 flex flex-col sm:flex-row items-center justify-between gap-4">

                            <!-- KAYIT BİLGİSİ -->
                            <div class="text-xs text-on-surface-variant">

                                @{
                                    int startRecord = ((currentPage - 1) * pageSize) + 1;

                                    int endRecord = Math.Min(
                                    currentPage * pageSize,
                                    totalRecords);
                                }

                                <span class="font-semibold text-on-surface">
                                    @startRecord - @endRecord
                                </span>

                                / @totalRecords kayıt gösteriliyor

                            </div>


                            <!-- SAYFALAR -->
                            <div class="flex items-center gap-1">

                                <!-- ÖNCEKİ -->
                                @if (currentPage > 1)
                                {
                                    <a href="?page=@(currentPage - 1)"
                                       class="w-9 h-9 flex items-center justify-center rounded-xl
                                      bg-surface-container
                                      text-on-surface-variant
                                      hover:bg-primary-container
                                      hover:text-on-primary-container
                                      transition">

                                        <span class="material-symbols-outlined text-lg">
                                            chevron_left
                                        </span>

                                    </a>
                                }
                                else
                                {
                                    <span class="w-9 h-9 flex items-center justify-center rounded-xl
                                         bg-surface-container/50
                                         text-on-surface-variant/30">

                                        <span class="material-symbols-outlined text-lg">
                                            chevron_left
                                        </span>

                                    </span>
                                }


                                <!-- SAYFA NUMARALARI -->
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    if (i == currentPage)
                                    {
                                        <span class="w-9 h-9 flex items-center justify-center rounded-xl
                                                 bg-primary
                                                 text-on-primary
                                                 text-xs font-bold">

                                            @i

                                        </span>
                                    }
                                    else if (
                                    i == 1 ||
                                    i == totalPages ||
                                    Math.Abs(i - currentPage) <= 2)
                                    {
                                        <a href="?page=@i"
                                           class="w-9 h-9 flex items-center justify-center rounded-xl
                                              bg-surface-container
                                              text-on-surface-variant
                                              hover:bg-primary-container
                                              hover:text-on-primary-container
                                              text-xs font-semibold
                                              transition">

                                            @i

                                        </a>
                                    }
                                    else if (
                                    i == currentPage - 3 ||
                                    i == currentPage + 3)
                                    {
                                        <span class="w-9 h-9 flex items-center justify-center
                                                 text-on-surface-variant/50">

                                            ...

                                        </span>
                                    }
                                }


                                <!-- SONRAKİ -->
                                @if (currentPage < totalPages)
                                {
                                    <a href="?page=@(currentPage + 1)"
                                       class="w-9 h-9 flex items-center justify-center rounded-xl
                                      bg-surface-container
                                      text-on-surface-variant
                                      hover:bg-primary-container
                                      hover:text-on-primary-container
                                      transition">

                                        <span class="material-symbols-outlined text-lg">
                                            chevron_right
                                        </span>

                                    </a>
                                }
                                else
                                {
                                    <span class="w-9 h-9 flex items-center justify-center rounded-xl
                                         bg-surface-container/50
                                         text-on-surface-variant/30">

                                        <span class="material-symbols-outlined text-lg">
                                            chevron_right
                                        </span>

                                    </span>
                                }

                            </div>

                        </div>
                    }
                </div>
            }

        </div>


        <!-- SAĞ PANEL -->
        <div class="space-y-6">

            <!-- MODEL NASIL ÇALIŞIYOR -->
            <div class="bg-surface p-6 rounded-3xl border border-outline-variant/30 shadow-sm">

                <div class="flex items-center gap-2.5 mb-4">

                    <div class="bg-primary-container p-2 rounded-xl text-on-primary-container">

                        <span class="material-symbols-outlined text-xl">
                            psychology
                        </span>

                    </div>

                    <h2 class="text-lg font-semibold text-on-surface">
                        Model Nasıl Çalışıyor?
                    </h2>

                </div>


                <div class="space-y-3">

                    <div class="p-3 rounded-2xl bg-surface-container-low/50 border border-outline-variant/10">

                        <strong class="text-on-surface text-xs block">
                            Ürün
                        </strong>

                        <p class="text-[11px] text-on-surface-variant mt-1">
                            Satış davranışı şehir ve ürün bazında değerlendirilir.
                        </p>

                    </div>


                    <div class="p-3 rounded-2xl bg-surface-container-low/50 border border-outline-variant/10">

                        <strong class="text-on-surface text-xs block">
                            Son 3 Aylık Satış
                        </strong>

                        <p class="text-[11px] text-on-surface-variant mt-1">
                            Geçmiş satış performansı modelin temel girdisidir.
                        </p>

                    </div>


                    <div class="p-3 rounded-2xl bg-surface-container-low/50 border border-outline-variant/10">

                        <strong class="text-on-surface text-xs block">
                            Geçen Ay Satış
                        </strong>

                        <p class="text-[11px] text-on-surface-variant mt-1">
                            En güncel satış performansı tahminde kullanılır.
                        </p>

                    </div>


                    <div class="p-3 rounded-2xl bg-surface-container-low/50 border border-outline-variant/10">

                        <strong class="text-on-surface text-xs block">
                            3 Aylık Ortalama
                        </strong>

                        <p class="text-[11px] text-on-surface-variant mt-1">
                            Son üç aylık satışların ortalaması ek özellik olarak kullanılır.
                        </p>

                    </div>


                    <div class="p-3 rounded-2xl bg-surface-container-low/50 border border-outline-variant/10">

                        <strong class="text-on-surface text-xs block">
                            @threshold.ToString("N0") Eşiği
                        </strong>

                        <p class="text-[11px] text-on-surface-variant mt-1">
                            Gelecek ay satışlarının
                            @threshold.ToString("N0")
                            veya üzeri olması AŞTI,
                            altı olması ALTINDA olarak sınıflandırılır.
                        </p>

                    </div>

                </div>

            </div>


            <!-- METRİKLER -->
            <div class="bg-surface p-6 rounded-3xl border border-outline-variant/30 shadow-sm">

                <div class="flex items-center gap-2.5 mb-4">

                    <div class="bg-secondary-container p-2 rounded-xl text-on-secondary-container">

                        <span class="material-symbols-outlined text-xl">
                            help
                        </span>

                    </div>

                    <h2 class="text-lg font-semibold text-on-surface">
                        Metrikler Ne Anlatıyor?
                    </h2>

                </div>


                <div class="space-y-3.5 text-xs text-on-surface-variant">

                    <div class="p-3 rounded-2xl bg-surface-container-low/50 border border-outline-variant/10">

                        <strong class="text-on-surface block mb-0.5">
                            Accuracy
                        </strong>

                        Test verilerindeki doğru tahmin oranıdır.

                    </div>


                    <div class="p-3 rounded-2xl bg-surface-container-low/50 border border-outline-variant/10">

                        <strong class="text-on-surface block mb-0.5">
                            Precision
                        </strong>

                        AŞTI olarak tahmin edilen kayıtların ne kadarının doğru olduğunu gösterir.

                    </div>


                    <div class="p-3 rounded-2xl bg-surface-container-low/50 border border-outline-variant/10">

                        <strong class="text-on-surface block mb-0.5">
                            F1 Puanı
                        </strong>

                        Precision ve Recall arasındaki dengeli performansı gösterir.

                    </div>


                    <div class="p-3 rounded-2xl bg-surface-container-low/50 border border-outline-variant/10">

                        <strong class="text-on-surface block mb-0.5">
                            AUC
                        </strong>

                        Modelin iki sınıfı ayırt etme başarısını gösterir.

                    </div>

                </div>


                <div class="mt-5 pt-4 border-t border-outline-variant/20 flex items-center justify-between text-[11px] text-on-surface-variant/70">

                    <span>
                        Test Oranı: %20
                    </span>

                    <span class="font-mono">
                        ML.NET Engine
                    </span>

                </div>

            </div>


            <!-- EN GÜÇLÜ TAHMİN -->
            @if (bestPrediction != null)
            {

                <div class="bg-surface p-6 rounded-3xl border border-outline-variant/30 shadow-sm">

                    <div class="flex items-center gap-2.5 mb-4">

                        <div class="bg-emerald-500/10 p-2 rounded-xl text-emerald-600">

                            <span class="material-symbols-outlined text-xl">
                                star
                            </span>

                        </div>

                        <h2 class="text-lg font-semibold text-on-surface">
                            En Güçlü Tahmin
                        </h2>

                    </div>


                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-xs text-on-surface-variant">
                                @bestPrediction.City
                            </p>

                            <p class="text-xs text-on-surface-variant mt-1">
                                @bestPrediction.ProductName
                            </p>

                            <p class="text-xl font-extrabold mt-1
                                    @(bestPrediction.PredictedLabel
                                                                   ? "text-emerald-600"
                                                                   : "text-rose-600")">

                                @(bestPrediction.PredictedLabel
                                                            ? "AŞTI"
                                                            : "ALTINDA")

                        </p>

                        </div>


                        <div class="text-right">

                            <p class="text-xs text-on-surface-variant">
                                Probability
                            </p>

                            <p class="text-xl font-extrabold text-on-surface">
                                @((bestPrediction.Probability * 100).ToString("N1"))%
                            </p>

                        </div>

                    </div>


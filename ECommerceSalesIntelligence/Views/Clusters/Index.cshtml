@model List<ECommerceSalesIntelligence.Models.ClusterResultViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Şehir Kümeleme ve Segmentasyon";

    // Güvenli model oluştur
    var data = Model ?? new List<ECommerceSalesIntelligence.Models.ClusterResultViewModel>();

    // Kümeleri ID'ye göre grupla
    var clusters = data.GroupBy(x => x.ClusterId).OrderBy(x => x.Key).ToList();

    // Genel dashboard değerlerini hesapla.
    var totalCities = data.Count; // Toplam şehir sayısı
    var clusterCount = clusters.Count; // Toplam küme sayısı
    var totalRevenue = data.Sum(x => x.TotalRevenue); // Toplam ciro
    var avgQuantity = data.Any() ? data.Average(x => x.TotalQuantity) : 0; // Ortalama satış miktarı
    var avgUnitPrice = data.Any() ? data.Average(x => x.AverageUnitPrice) : 0; // Ortalama birim fiyat
    var avgOrderAmount = data.Any() ? data.Average(x => x.AverageOrderAmount) : 0; // Ortalama sepet tutarı
    var avgCampaignRate = data.Any() ? data.Average(x => x.CampaignRate) : 0; // Ortalama kampanya oranı
    var globalRevenuePerCity = totalCities > 0 ? totalRevenue / totalCities : 0; // Şehir başına ortalama ciro

    string GetClusterColor(int id) => id switch
    {
        1 => "border-blue-400/40 bg-blue-500/[0.07]",
        2 => "border-emerald-400/40 bg-emerald-500/[0.07]",
        _ => "border-slate-400/40 bg-slate-500/[0.07]"
    };
    string GetClusterTextColor(int id) => id switch
    {
        1 => "text-blue-600",
        2 => "text-emerald-600",
        _ => "text-slate-600"
    };
    string GetClusterBadge(int id) => id switch
    {
        1 => "bg-blue-500/10 text-blue-700 border-blue-500/20",
        2 => "bg-emerald-500/10 text-emerald-700 border-emerald-500/20",
        _ => "bg-slate-500/10 text-slate-700 border-slate-500/20"
    };
    string GetClusterIcon(int id) => id switch
    {
        1 => "campaign",
        2 => "trending_up",
        _ => "hub"
    };

    string GetClusterName(
        double quantity,
        double orderAmount,
        double campaignRate,
        double revenuePerCity,
        double categoryDiversity)
    {
        var quantityRatio = avgQuantity > 0
            ? quantity / avgQuantity
            : 1;

        var campaignText = campaignRate >= 0.75
            ? "Yüksek Kampanya Bağımlılığı"
            : campaignRate <= 0.25
                ? "Düşük Kampanya Bağımlılığı"
                : "Dengeli Kampanya Kullanımı";

        var volumeText = quantityRatio >= 1.15
            ? "Yüksek Hacim"
            : quantityRatio <= 0.85
                ? "Düşük Hacim"
                : "Orta Hacim";

        return $"{campaignText} · {volumeText}";
    }

    string GetClusterDescription(
        double quantity,
        double orderAmount,
        double campaignRate,
        double revenuePerCity,
        double categoryRate,
        double categoryDiversity)
    {
        var quantityRatio = avgQuantity > 0 ? quantity / avgQuantity : 1;
        var orderRatio = avgOrderAmount > 0 ? orderAmount / avgOrderAmount : 1;
        var revenueRatio = globalRevenuePerCity > 0 ? revenuePerCity / globalRevenuePerCity : 1;

        var campaignText = campaignRate >= 0.75
            ? "Satışların büyük bölümü kampanyalı işlemlerden oluşmaktadır."
            : campaignRate <= 0.25
                ? "Satışlar kampanyalara düşük bağımlılıkla gerçekleşmektedir."
                : "Kampanyalı ve kampanyasız satışlar dengeli bir yapı göstermektedir.";

        var volumeText = quantityRatio >= 1.15
            ? "Satış hacmi şehir ortalamasının üzerindedir."
            : quantityRatio <= 0.85
                ? "Satış hacmi şehir ortalamasının altındadır."
                : "Satış hacmi şehir ortalamasına yakındır.";

        var orderText = orderRatio >= 1.15
            ? "Ortalama sepet değeri yüksektir."
            : orderRatio <= 0.85
                ? "Ortalama sepet değeri düşüktür."
                : "Ortalama sepet değeri dengelidir.";

        var revenueText = revenueRatio >= 1.15
            ? "Şehir başına ciro üretimi yüksektir."
            : revenueRatio <= 0.85
                ? "Şehir başına ciro üretimi düşüktür."
                : "Şehir başına ciro üretimi dengelidir.";

        var categoryText = categoryRate >= 0.30
            ? "Satışlar belirli kategorilerde yoğunlaşmaktadır."
            : categoryDiversity >= 1.5
                ? "Kategori dağılımı çeşitlidir."
                : "Kategori dağılımı dengelidir.";

        return $"{campaignText} {volumeText} {orderText} {revenueText} {categoryText}";
    }

    string GetCategoryColor(int index) => index switch
    {
        0 => "#3b82f6",
        1 => "#10b981",
        2 => "#f59e0b",
        3 => "#8b5cf6",
        4 => "#ec4899",
        5 => "#06b6d4",
        6 => "#f97316",
        7 => "#14b8a6",
        _ => "#94a3b8"
    };
}

<div class="min-h-screen bg-surface-container-low p-4 md:p-5">
    <div class="max-w-[1380px] mx-auto space-y-4">

        <!-- BAŞLIK -->
        <section class="bg-surface rounded-2xl border border-outline-variant/30 shadow-sm px-5 py-4">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2 text-primary text-[11px] font-bold uppercase tracking-wider">
                        <span class="material-symbols-outlined text-[17px]">hub</span>
                        Makine Öğrenmesi & Segmentasyon
                    </div>

                    <h1 class="text-xl md:text-2xl font-extrabold text-on-surface mt-1">
                        Şehir Kümeleme Analizi
                    </h1>

                    <p class="text-sm text-on-surface-variant mt-1.5 max-w-3xl leading-5">
                        Şehirler; satış hacmi, sepet değeri, kampanya kullanımı,
                        indirim ve kategori davranışlarına göre K-Means algoritması
                        kullanılarak benzer satış segmentlerine ayrılmıştır.
                    </p>
                </div>

                <div class="flex flex-wrap gap-2 shrink-0">
                    <span class="px-3 py-1.5 rounded-lg bg-primary/10 text-primary text-[11px] font-bold">
                        K-Means
                    </span>

                    <span class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface text-[11px] font-bold">
                        K = @clusterCount
                    </span>

                    <span class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface text-[11px] font-bold">
                        Mean-Variance
                    </span>

                    <span class="px-3 py-1.5 rounded-lg bg-purple-500/10 text-purple-700 text-[11px] font-bold">
                        Kategori Analizi
                    </span>
                </div>
            </div>
        </section>

        <!-- KPI KARTLARI -->
        <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">

            <div class="bg-surface rounded-2xl border border-blue-500/15 shadow-sm p-4">
                <p class="text-[10px] uppercase tracking-wider font-bold text-blue-600">
                    Analiz Edilen Şehir
                </p>

                <p class="text-2xl font-black text-on-surface mt-2">
                    @totalCities
                </p>

                <p class="text-[10px] text-on-surface-variant mt-1">
                    Kümeye dahil edilen şehir sayısı
                </p>
            </div>

            <div class="bg-surface rounded-2xl border border-emerald-500/15 shadow-sm p-4">
                <p class="text-[10px] uppercase tracking-wider font-bold text-emerald-600">
                    Oluşan Küme
                </p>

                <p class="text-2xl font-black text-on-surface mt-2">
                    @clusterCount
                </p>

                <p class="text-[10px] text-on-surface-variant mt-1">
                    K-Means segment sayısı
                </p>
            </div>

            <div class="bg-surface rounded-2xl border border-amber-500/15 shadow-sm p-4">
                <p class="text-[10px] uppercase tracking-wider font-bold text-amber-600">
                    Ortalama Satış
                </p>

                <p class="text-2xl font-black text-on-surface mt-2">
                    @avgQuantity.ToString("N0")
                </p>

                <p class="text-[10px] text-on-surface-variant mt-1">
                    Şehir başına ortalama satış
                </p>
            </div>

            <div class="bg-surface rounded-2xl border border-purple-500/15 shadow-sm p-4">
                <p class="text-[10px] uppercase tracking-wider font-bold text-purple-600">
                    Toplam Ciro
                </p>

                <p class="text-2xl font-black text-on-surface mt-2">
                    @totalRevenue.ToString("N0") ₺
                </p>

                <p class="text-[10px] text-on-surface-variant mt-1">
                    Tüm şehirlerin toplam cirosu
                </p>
            </div>
        </section>

        <!-- METODOLOJİ + YORUMLAMA -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-4">

            <!-- METODOLOJİ -->
            <div class="bg-surface rounded-2xl border border-primary/15 shadow-sm p-4">
                <div class="flex items-center justify-between">
                    <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">
                            psychology
                        </span>
                    </div>

                    <span class="px-2.5 py-1 rounded-lg bg-primary/10 text-primary text-[9px] font-extrabold">
                        METODOLOJİ
                    </span>
                </div>

                <h2 class="text-sm font-black text-on-surface mt-3">
                    Kümeleme Nasıl Yapılıyor?
                </h2>

                <p class="text-[10px] text-on-surface-variant mt-1.5 leading-4">
                    Her şehir için satış davranışlarını temsil eden sayısal özellikler
                    oluşturulur, ölçekleri dengelenir ve K-Means ile benzer şehirler
                    aynı segmente atanır.
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-4">

                    <div class="flex items-start gap-2">
                        <div class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-600 flex items-center justify-center shrink-0">
                            <span class="text-[9px] font-black">01</span>
                        </div>

                        <div>
                            <p class="text-[10px] font-extrabold text-on-surface">
                                Özellik Çıkarımı
                            </p>

                            <p class="text-[9px] text-on-surface-variant leading-3.5 mt-0.5">
                                Satış, sepet, kampanya ve kategori davranışları hesaplanır.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-2">
                        <div class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0">
                            <span class="text-[9px] font-black">02</span>
                        </div>

                        <div>
                            <p class="text-[10px] font-extrabold text-on-surface">
                                Normalizasyon
                            </p>

                            <p class="text-[9px] text-on-surface-variant leading-3.5 mt-0.5">
                                Özellikler Mean-Variance yöntemiyle ölçeklenir.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-2">
                        <div class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-600 flex items-center justify-center shrink-0">
                            <span class="text-[9px] font-black">03</span>
                        </div>

                        <div>
                            <p class="text-[10px] font-extrabold text-on-surface">
                                K-Means
                            </p>

                            <p class="text-[9px] text-on-surface-variant leading-3.5 mt-0.5">
                                Benzer satış davranışları aynı kümeye atanır.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-outline-variant/20">
                    <p class="text-[9px] font-bold text-on-surface mb-1.5">
                        Kullanılan K-Means Özellikleri
                    </p>

                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var feature in new[]
                                                {
                                                "Günlük Satış",
                                                "Sepet Tutarı",
                                                "Kampanya Oranı",
                                                "İndirim Oranı",
                                                "Kategori Sayısı",
                                                "Baskın Kategori",
                                                "Kategori Çeşitliliği"
                                                })
                        {
                            <span class="px-2 py-1 rounded-md bg-surface-container text-[8px] font-semibold text-on-surface-variant">
                                @feature
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- YORUMLAMA -->
            <div class="bg-surface rounded-2xl border border-amber-500/15 shadow-sm p-4">
                <div class="flex items-center justify-between">
                    <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">
                            lightbulb
                        </span>
                    </div>

                    <span class="px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-600 text-[9px] font-extrabold">
                        YORUMLAMA
                    </span>
                </div>

                <h2 class="text-sm font-black text-on-surface mt-3">
                    Sonuçlar Nasıl Okunmalı?
                </h2>

                <p class="text-[10px] text-on-surface-variant mt-1.5 leading-4">
                    Küme numarası başarı sıralaması değildir. Her küme şehirlerin
                    benzer satış davranışlarını temsil eden bağımsız bir segmenttir.
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">

                    <div class="flex items-start gap-2">
                        <span class="w-2 h-2 rounded-full bg-blue-500 mt-1.5 shrink-0"></span>

                        <p class="text-[9px] text-on-surface-variant leading-3.5">
                            <strong class="text-on-surface">Satış:</strong>
                            Şehrin satış hacmini gösterir.
                        </p>
                    </div>

                    <div class="flex items-start gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 mt-1.5 shrink-0"></span>

                        <p class="text-[9px] text-on-surface-variant leading-3.5">
                            <strong class="text-on-surface">Sepet:</strong>
                            Sipariş başına ekonomik değeri gösterir.
                        </p>
                    </div>

                    <div class="flex items-start gap-2">
                        <span class="w-2 h-2 rounded-full bg-purple-500 mt-1.5 shrink-0"></span>

                        <p class="text-[9px] text-on-surface-variant leading-3.5">
                            <strong class="text-on-surface">Kategori:</strong>
                            Ürün çeşitliliğini ve yoğunlaşmayı gösterir.
                        </p>
                    </div>

                    <div class="flex items-start gap-2">
                        <span class="w-2 h-2 rounded-full bg-amber-500 mt-1.5 shrink-0"></span>

                        <p class="text-[9px] text-on-surface-variant leading-3.5">
                            <strong class="text-on-surface">Kampanya:</strong>
                            Satışların kampanyaya bağımlılığını gösterir.
                        </p>
                    </div>
                </div>

                <div class="mt-4 p-2.5 rounded-xl bg-amber-500/[0.06] border border-amber-500/10">
                    <div class="flex gap-2">
                        <span class="material-symbols-outlined text-amber-600 text-[16px]">
                            info
                        </span>

                        <p class="text-[9px] text-on-surface-variant leading-3.5">
                            <strong class="text-on-surface">Önemli:</strong>
                            Küme numaraları modelin ham ID'si değildir. Serviste
                            davranış özelliklerine göre yeniden sıralanmış segment etiketleridir.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- KÜME PROFİLLERİ -->
        <!-- KÜME PROFİLLERİ -->
        <section>
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
                <div>
                    <h2 class="text-base font-extrabold text-on-surface">Küme Profilleri</h2>
                    <p class="text-[11px] text-on-surface-variant mt-0.5">
                        K-Means sonucunda oluşan şehir segmentlerinin davranış profilleri.
                    </p>
                </div>
                <span class="px-2.5 py-1.5 rounded-lg bg-surface border border-outline-variant/20 text-[9px] font-bold text-on-surface-variant">
                    @clusterCount farklı segment
                </span>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
                @foreach (var group in clusters)
                {
                    var clusterId = (int)group.Key;
                    var colorClass = GetClusterColor(clusterId);
                    var badgeClass = GetClusterBadge(clusterId);
                    var textColor = GetClusterTextColor(clusterId);
                    var icon = GetClusterIcon(clusterId);

                    var groupQuantity = group.Average(x => x.TotalQuantity);
                    var groupPrice = group.Average(x => x.AverageUnitPrice);
                    var groupOrder = group.Average(x => x.AverageOrderAmount);
                    var groupRevenue = group.Sum(x => x.TotalRevenue);
                    var groupCampaign = group.Average(x => x.CampaignRate);
                    var groupDiversity = group.Average(x => x.CategoryDiversity);
                    var revenuePerCity = group.Count() > 0 ? groupRevenue / group.Count() : 0;

                    var clusterCategories = group
                    .SelectMany(x => x.CategoryDistribution ?? new List<ECommerceSalesIntelligence.Models.Cluster.CategoryDistributionSummaryViewModel>())
                    .GroupBy(x => x.CategoryName)
                    .Select(g => new
                    {
                        Name = g.Key,
                        Quantity = g.Sum(x => x.Quantity),
                        Revenue = g.Sum(x => x.Revenue)
                    })
                    .OrderByDescending(x => x.Quantity)
                    .ToList();

                    var categoryCount = clusterCategories.Count;
                    var clusterCategoryTotal = clusterCategories.Sum(x => x.Quantity);
                    var dominantCategory = clusterCategories.FirstOrDefault();

                    var dominantCategoryPercentage =
                    dominantCategory != null && clusterCategoryTotal > 0
                    ? dominantCategory.Quantity / (double)clusterCategoryTotal
                    : 0;

                    var profileName = GetClusterName(
                    groupQuantity,
                    groupOrder,
                    groupCampaign,
                    revenuePerCity,
                    groupDiversity);

                    var description = GetClusterDescription(
                    groupQuantity,
                    groupOrder,
                    groupCampaign,
                    revenuePerCity,
                    dominantCategoryPercentage,
                    groupDiversity);

                    var categorySlices = new List<string>();
                    double currentPercentage = 0;

                    for (int i = 0; i < clusterCategories.Count; i++)
                    {
                        var category = clusterCategories[i];

                        var percentage = clusterCategoryTotal > 0
                        ? category.Quantity / (double)clusterCategoryTotal * 100
                        : 0;

                        var start = currentPercentage;
                        var end = currentPercentage + percentage;

                        categorySlices.Add(
                        $"{GetCategoryColor(i)} {start:F2}% {end:F2}%");

                        currentPercentage = end;
                    }

                    var pieBackground = categorySlices.Any()
                    ? $"conic-gradient({string.Join(", ", categorySlices)})"
                    : "conic-gradient(#e5e7eb 0% 100%)";

                    <div class="rounded-2xl border @colorClass bg-surface shadow-sm overflow-hidden hover:shadow-md transition-all duration-200">

                        <!-- ÜST BÖLÜM -->
                        <div class="px-5 py-4 border-b border-outline-variant/20">

                            <div class="flex items-center justify-between gap-3">

                                <div class="flex items-center gap-3 min-w-0">

                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border @badgeClass text-[10px] font-extrabold shrink-0">
                                        <span class="material-symbols-outlined text-[15px]">
                                            @icon
                                        </span>
                                        Küme @clusterId
                                    </span>

                                    <div class="min-w-0">
                                        <h3 class="text-sm font-black text-on-surface truncate">
                                            @profileName
                                        </h3>

                                        <p class="text-[9px] text-on-surface-variant mt-0.5">
                                            @group.Count() şehir
                                        </p>
                                    </div>
                                </div>

                                <span class="material-symbols-outlined @textColor text-[22px] shrink-0">
                                    @icon
                                </span>
                            </div>

                            <p class="text-[10px] font-medium text-on-surface-variant mt-3 leading-4">
                                @description
                            </p>
                        </div>

                        <!-- METRİKLER YATAY -->
                        <div class="grid grid-cols-2 md:grid-cols-4 border-b border-outline-variant/20">

                            <div class="px-4 py-3 border-r border-outline-variant/20">
                                <span class="block text-[9px] uppercase tracking-wide text-on-surface-variant font-bold">
                                    Ort. Satış
                                </span>

                                <span class="block text-base font-black text-on-surface mt-1">
                                    @groupQuantity.ToString("N0")
                                </span>
                            </div>

                            <div class="px-4 py-3 md:border-r border-outline-variant/20">
                                <span class="block text-[9px] uppercase tracking-wide text-on-surface-variant font-bold">
                                    Ort. Birim Fiyat
                                </span>

                                <span class="block text-base font-black text-on-surface mt-1">
                                    @groupPrice.ToString("N2") ₺
                                </span>
                            </div>

                            <div class="px-4 py-3 border-r border-outline-variant/20">
                                <span class="block text-[9px] uppercase tracking-wide text-on-surface-variant font-bold">
                                    Ort. Sepet
                                </span>

                                <span class="block text-base font-black text-on-surface mt-1">
                                    @groupOrder.ToString("N2") ₺
                                </span>
                            </div>

                            <div class="px-4 py-3">
                                <span class="block text-[9px] uppercase tracking-wide text-on-surface-variant font-bold">
                                    Kampanya
                                </span>

                                <span class="block text-base font-black @textColor mt-1">
                                    @groupCampaign.ToString("P1")
                                </span>
                            </div>
                        </div>

                        <!-- ALT İÇERİK -->
                        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-0">

                            <!-- KATEGORİ -->
                            <div class="p-4 border-b lg:border-b-0 lg:border-r border-outline-variant/20">

                                <div class="flex items-center justify-between mb-3">
                                    <div>
                                        <span class="block text-[9px] uppercase tracking-wide font-bold text-on-surface-variant">
                                            Kategori Dağılımı
                                        </span>

                                        <span class="text-[8px] text-on-surface-variant">
                                            @categoryCount farklı kategori
                                        </span>
                                    </div>

                                    <span class="text-[8px] text-on-surface-variant">
                                        Satış miktarı
                                    </span>
                                </div>

                                <div class="flex items-center gap-4">

                                    <div class="w-20 h-20 rounded-full shrink-0 relative"
                                         style="background:@pieBackground">

                                        <div class="absolute inset-[15px] rounded-full bg-surface flex items-center justify-center">
                                            <span class="text-[10px] font-black text-on-surface">
                                                @categoryCount
                                            </span>
                                        </div>
                                    </div>

                                    <div class="min-w-0 flex-1 space-y-2">

                                        @foreach (var category in clusterCategories.Take(4))
                                        {
                                            var categoryPercentage = clusterCategoryTotal > 0
                                            ? category.Quantity / (double)clusterCategoryTotal * 100
                                            : 0;

                                            var categoryIndex = clusterCategories.IndexOf(category);

                                            <div class="flex items-center justify-between gap-2">

                                                <div class="flex items-center gap-1.5 min-w-0">
                                                    <span class="w-2 h-2 rounded-full shrink-0"
                                                          style="background:@GetCategoryColor(categoryIndex)">
                                                    </span>

                                                    <span class="text-[9px] text-on-surface truncate"
                                                          title="@category.Name">
                                                        @category.Name
                                                    </span>
                                                </div>

                                                <span class="text-[9px] font-bold text-on-surface-variant shrink-0">
                                                    @categoryPercentage.ToString("N1")%
                                                </span>
                                            </div>
                                        }

                                        @if (clusterCategories.Count > 4)
                                        {
                                            <p class="text-[8px] text-on-surface-variant">
                                                +@(clusterCategories.Count - 4) kategori daha
                                            </p>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- CİRO + ÖZET -->
                            <div class="p-4">

                                <div class="grid grid-cols-2 gap-3">

                                    <div class="rounded-xl bg-surface-container-low border border-outline-variant/15 p-3">
                                        <span class="block text-[9px] uppercase tracking-wide font-bold text-on-surface-variant">
                                            Şehir Başına Ciro
                                        </span>

                                        <span class="block text-base font-black @textColor mt-1">
                                            @revenuePerCity.ToString("N0") ₺
                                        </span>

                                        <span class="block text-[8px] text-on-surface-variant mt-0.5">
                                            Ortalama şehir cirosu
                                        </span>
                                    </div>

                                    <div class="rounded-xl bg-surface-container-low border border-outline-variant/15 p-3">
                                        <span class="block text-[9px] uppercase tracking-wide font-bold text-on-surface-variant">
                                            Kümenin Toplam Cirosu
                                        </span>

                                        <span class="block text-base font-black text-on-surface mt-1">
                                            @groupRevenue.ToString("N0") ₺
                                        </span>

                                        <span class="block text-[8px] text-on-surface-variant mt-0.5">
                                            @group.Count() şehrin toplamı
                                        </span>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-3 mt-3">

                                    <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-surface-container-low">
                                        <span class="text-[9px] text-on-surface-variant">
                                            Baskın Kategori
                                        </span>

                                        <span class="text-[9px] font-black text-on-surface truncate ml-2"
                                              title="@dominantCategory?.Name">
                                            @(dominantCategory?.Name ?? "-")
                                        </span>
                                    </div>

                                    <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-surface-container-low">
                                        <span class="text-[9px] text-on-surface-variant">
                                            Satış Payı
                                        </span>

                                        <span class="text-[9px] font-black @textColor">
                                            @((dominantCategoryPercentage * 100).ToString("N1"))%
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
        <!-- ŞEHİR BAZLI KÜME ATAMA -->
        <section class="bg-surface rounded-2xl border border-outline-variant/30 shadow-sm overflow-hidden">

            <div class="px-5 py-4 border-b border-outline-variant/20 flex items-center justify-between gap-3">

                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-[18px]">
                            location_city
                        </span>
                    </div>

                    <div>
                        <h2 class="text-base font-extrabold text-on-surface">
                            Şehir Bazlı Küme Atama
                        </h2>

                        <p class="text-[10px] text-on-surface-variant mt-0.5">
                            Şehirlerin gerçek satış davranışlarına göre atanmış segmentleri.
                        </p>
                    </div>
                </div>

                <span class="px-2.5 py-1.5 rounded-lg bg-surface-container text-[10px] font-bold text-on-surface whitespace-nowrap">
                    @totalCities şehir
                </span>
            </div>

            @if (!data.Any())
            {
                <div class="py-12 text-center">
                    <span class="material-symbols-outlined text-3xl text-on-surface-variant">
                        location_off
                    </span>

                    <p class="text-sm font-semibold text-on-surface mt-2">
                        Kümeleme verisi bulunamadı.
                    </p>
                </div>
            }
            else
            {
                <div class="p-3">
                    <div class="rounded-xl border border-outline-variant/20 overflow-hidden">
                        <div class="overflow-x-auto">

                            <table class="w-full text-xs">

                                <thead>
                                    <tr class="bg-surface-container-low text-[9px] uppercase tracking-wide text-on-surface-variant">

                                        <th class="px-3 py-2.5 text-left font-bold">
                                            Şehir
                                        </th>

                                        <th class="px-3 py-2.5 text-right font-bold">
                                            Satış
                                        </th>

                                        <th class="px-3 py-2.5 text-right font-bold">
                                            Birim Fiyat
                                        </th>

                                        <th class="px-3 py-2.5 text-right font-bold">
                                            Sepet
                                        </th>

                                        <th class="px-3 py-2.5 text-right font-bold">
                                            Ciro
                                        </th>

                                        <th class="px-3 py-2.5 text-center font-bold">
                                            Kampanya
                                        </th>

                                        <th class="px-3 py-2.5 text-center font-bold">
                                            Küme
                                        </th>
                                    </tr>
                                </thead>

                                <tbody class="divide-y divide-outline-variant/10">

                                    @foreach (var item in data.OrderByDescending(x => x.TotalRevenue))
                                    {
                                        var rowCluster = (int)item.ClusterId;

                                        <tr class="hover:bg-surface-container-low transition-colors">

                                            <td class="px-3 py-2.5 font-bold text-on-surface whitespace-nowrap">
                                                @item.City
                                            </td>

                                            <td class="px-3 py-2.5 text-right font-mono text-on-surface whitespace-nowrap">
                                                @item.TotalQuantity.ToString("N0")
                                            </td>

                                            <td class="px-3 py-2.5 text-right font-mono text-on-surface-variant whitespace-nowrap">
                                                @item.AverageUnitPrice.ToString("N2") ₺
                                            </td>

                                            <td class="px-3 py-2.5 text-right font-mono text-on-surface-variant whitespace-nowrap">
                                                @item.AverageOrderAmount.ToString("N2") ₺
                                            </td>

                                            <td class="px-3 py-2.5 text-right font-mono font-bold text-primary whitespace-nowrap">
                                                @item.TotalRevenue.ToString("N0") ₺
                                            </td>

                                            <td class="px-3 py-2.5 text-center">
                                                <span class="text-[9px] font-bold">
                                                    @item.CampaignRate.ToString("P1")
                                                </span>
                                            </td>

                                            <td class="px-3 py-2.5 text-center">

                                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md border @GetClusterBadge(rowCluster) text-[9px] font-extrabold whitespace-nowrap">

                                                    <span class="material-symbols-outlined text-[12px]">
                                                        @GetClusterIcon(rowCluster)
                                                    </span>

                                                    Küme @rowCluster
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </section>

        <!-- ALT NOT -->
        <section class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 px-1">

            <p class="text-[10px] text-on-surface-variant leading-4">
                K-Means şehirleri günlük satış hacmi, sepet tutarı, kampanya,
                indirim ve kategori davranışlarına göre gruplandırır.
                Küme numaraları performans sıralaması değildir.
            </p>

            <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-on-surface-variant">
                    Normalizasyon
                </span>

                <span class="px-2 py-1 rounded-md bg-surface text-[10px] font-bold text-on-surface border border-outline-variant/20">
                    Mean-Variance
                </span>
            </div>
        </section>

    </div>
</div>
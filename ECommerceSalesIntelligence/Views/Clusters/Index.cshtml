@model List<ECommerceSalesIntelligence.Models.ClusterResultViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Şehir Kümeleme ve Segmentasyon";
    var clusterGroups = Model.GroupBy(m => m.ClusterId).OrderBy(g => g.Key).ToList();
}

<div class="flex flex-col w-full gap-8 pb-12 p-6">

    <!-- ÜST BAŞLIK VE ANALİTİK AÇIKLAMA -->
    <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-surface-container">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <span class="text-xs font-bold text-primary uppercase tracking-widest">Makine Öğrenmesi & Model Çıktısı</span>
                <h2 class="text-2xl font-bold text-on-surface mt-1">30 Şehir İçin K-Means Kümeleme Analizi</h2>
            </div>
            <div class="flex gap-2">
                <span class="px-3 py-1.5 rounded-lg bg-surface-container font-mono text-xs font-bold text-on-surface">
                    Algoritma: K-Means (K=4)
                </span>
                <span class="px-3 py-1.5 rounded-lg bg-surface-container font-mono text-xs font-bold text-on-surface">
                    Normalizasyon: Min-Max
                </span>
            </div>
        </div>
        <p class="text-on-surface-variant text-sm mt-3 leading-relaxed">
            Bu analizde; şehirlerin <strong>Ortalama Birim Fiyatı</strong> (ürün bazlı fiyatlandırma eğilimi), <strong>Ortalama Miktar</strong> (işlem hacmi yoğunluğu) ve <strong>Toplam Hacim</strong> (şehre ait toplam ciro üretimi) metrikleri ortak işleme alınmıştır. Veriler kendi aralarında scale edilerek 4 farklı performans kümesine ayrılmıştır.
        </p>
    </div>

    <!-- 4 KÜME İÇİN DETAYLI ANALİTİK KARTLAR -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        @foreach (var group in clusterGroups)
        {
            <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border-t-4 border-primary flex flex-col justify-between hover:shadow-md transition-shadow">
                <div>
                    <div class="flex justify-between items-center mb-3">
                        <span class="px-2.5 py-1 rounded-md bg-primary/10 text-primary font-bold text-xs">
                            Segment #@group.Key
                        </span>
                        <span class="text-xs font-semibold text-on-surface-variant">@group.Count() Şehir</span>
                    </div>

                    <h3 class="font-bold text-on-surface text-base mb-2">
                        @if (group.Key == 1)
                        {
                            <text>Tier-1: Metropol Pazar</text>
                        }
                        else if (group.Key == 2)
                        {

                            <text>Tier-2: Büyüyen Şehirler</text>
                        }
                        else if (group.Key == 3)
                        {

                            <text>Tier-3: Dengeli Pazar</text>
                        }
                        else
                        {

                            <text>Tier-4: Niche / Yerel Bölge</text>
                        }
                    </h3>
                </div>

                <div class="space-y-2 text-xs text-on-surface-variant font-mono mt-4 pt-4 border-t border-surface-container">
                    <div class="flex justify-between">
                        <span>Ort. Birim Fiyat:</span>
                        <span class="font-bold text-on-surface">@group.Average(x => x.UnitPrice).ToString("N2") ₺</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Ort. Miktar:</span>
                        <span class="font-bold text-on-surface">@group.Average(x => x.Quantity).ToString("N1")</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Toplam Ciro Hacmi:</span>
                        <span class="font-bold text-primary">@group.Sum(x => x.TotalAmount).ToString("N0") ₺</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- ŞEHİR PERFORMANS DAĞILIM TABLOSU -->
    <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
            <div>
                <h3 class="text-lg font-bold text-on-surface">Şehir Bazlı Küme Atama Matrisi</h3>
                <p class="text-xs text-on-surface-variant">Her bir şehrin metrik bazlı performans skoru ve dahil olduğu küme</p>
            </div>
            <div class="px-4 py-2 rounded-xl bg-surface-container font-mono text-xs font-bold text-on-surface">
                Analiz Edilen Şehir: @Model.Count / 30
            </div>
        </div>

        <div class="overflow-x-auto border border-surface-container rounded-xl">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container/50 text-xs text-on-surface-variant uppercase tracking-wider font-semibold">
                        <th class="p-4">Şehir Adı</th>
                        <th class="p-4">Ort. Birim Fiyat</th>
                        <th class="p-4">Ort. İşlem Miktarı</th>
                        <th class="p-4">Toplam Ciro Hacmi</th>
                        <th class="p-4 text-center">Atanan Küme</th>
                    </tr>
                </thead>
                <tbody class="text-sm text-on-surface divide-y divide-surface-container font-mono">
                    @foreach (var item in Model.OrderByDescending(x => x.TotalAmount))
                    {
                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="p-4 font-sans font-semibold text-on-surface">@item.City</td>
                            <td class="p-4">@item.UnitPrice.ToString("N2") ₺</td>
                            <td class="p-4">@item.Quantity.ToString("N1")</td>
                            <td class="p-4 font-bold text-primary">@item.TotalAmount.ToString("N0") ₺</td>
                            <td class="p-4 text-center">
                                <span class="px-3 py-1 rounded-lg bg-surface-container font-bold text-xs text-on-surface border border-surface-container-high">
                                    Küme @item.ClusterId
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>